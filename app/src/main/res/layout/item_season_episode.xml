<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="5dp"
    android:background="@drawable/bg_card_item"
    android:gravity="center_vertical">

    <CheckBox android:id="@+id/checkBox"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:buttonTint="@color/accent_cyan" android:checked="true"
        android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/tvLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="S01E01" android:textColor="@color/accent_cyan"
            android:textSize="12sp" android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"/>

        <TextView android:id="@+id/tvFilename"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_bright" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>

        <TextView android:id="@+id/tvSize"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_dim" android:textSize="10sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Edit (rename) button -->
    <ImageButton
        android:id="@+id/btnRename"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_icon_btn"
        android:src="@drawable/ic_edit"
        android:padding="7dp"
        android:tint="@color/text_dim"
        android:contentDescription="Renommer"
        android:layout_marginStart="6dp"/>

</LinearLayout>
