<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_shell">

    <LinearLayout
        android:id="@+id/addressBarContainer"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_address_bar"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:elevation="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Rechercher ou saisir une URL…"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_bright"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:selectAllOnFocus="true" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_star_outline"
            android:padding="9dp"
            android:tint="@color/status_warning"
            android:contentDescription="Ajouter aux favoris" />

        <ImageButton
            android:id="@+id/btnGo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn_cyan"
            android:src="@drawable/ic_arrow_right"
            android:padding="9dp"
            android:tint="@color/accent_cyan"
            android:contentDescription="Naviguer" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:progressTint="@color/accent_cyan"
        android:progressBackgroundTint="#331B120E"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/addressBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSeason"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="📺 SAISONS"
        android:textColor="@color/accent_magenta"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:background="@drawable/bg_icon_btn_cyan"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:elevation="14dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnBack"
            android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
            android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_arrow_left"
            android:padding="12dp" android:alpha="0.45"
            android:tint="@color/accent_cyan"
            android:contentDescription="Précédent"/>

        <ImageButton android:id="@+id/btnForward"
            android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_arrow_right"
            android:padding="12dp" android:alpha="0.45"
            android:tint="@color/accent_cyan"
            android:contentDescription="Suivant"/>

        <ImageButton android:id="@+id/btnRefresh"
            android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_refresh"
            android:padding="12dp"
            android:tint="@color/accent_cyan"
            android:contentDescription="Actualiser"/>

        <ImageButton android:id="@+id/btnHome"
            android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_home"
            android:padding="12dp"
            android:tint="@color/status_warning"
            android:contentDescription="Accueil"/>

        <FrameLayout android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp">
            <ImageButton android:id="@+id/btnNewTab"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_add"
                android:padding="12dp"
                android:tint="@color/accent_cyan"
                android:contentDescription="Nouvel onglet"/>
            <TextView android:id="@+id/btnTabBadge"
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge" android:textColor="@color/bg_primary"
                android:textSize="9sp" android:gravity="center" android:visibility="gone"/>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp">
            <ImageButton android:id="@+id/btnFavorites"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_star"
                android:padding="12dp"
                android:tint="@color/status_warning"
                android:contentDescription="Favoris"/>
            <TextView android:id="@+id/btnFavoritesBadge"
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge" android:textColor="@color/bg_primary"
                android:textSize="9sp" android:gravity="center" android:visibility="gone"/>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp">
            <ImageButton android:id="@+id/btnMedia"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_toolbar_btn_media" android:src="@drawable/ic_download"
                android:padding="12dp"
                android:tint="@color/accent_magenta"
                android:contentDescription="Médias"/>
            <TextView android:id="@+id/btnMediaBadge"
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge_magenta" android:textColor="@color/bg_primary"
                android:textSize="9sp" android:gravity="center" android:visibility="gone"/>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp">
            <ImageButton android:id="@+id/btnHistory"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_toolbar_btn" android:src="@drawable/ic_history"
                android:padding="12dp"
                android:tint="@color/accent_cyan"
                android:contentDescription="Historique"/>
            <TextView android:id="@+id/btnHistoryBadge"
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge_magenta" android:textColor="@color/bg_primary"
                android:textSize="9sp" android:gravity="center" android:visibility="gone"/>
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
