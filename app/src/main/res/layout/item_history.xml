<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card_item">

    <!-- Row 1: Info + Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Info column -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="10dp">

            <TextView android:id="@+id/tvFilename"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_bright" android:textSize="12sp"
                android:maxLines="2" android:ellipsize="middle"/>

            <TextView android:id="@+id/tvSeries"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent_violet" android:textSize="11sp"
                android:layout_marginTop="2dp" android:visibility="gone"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView android:id="@+id/tvDate"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text_dim" android:textSize="10sp"/>

                <TextView android:id="@+id/tvSize"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_dim" android:textSize="10sp"
                    android:layout_marginStart="10dp"/>

                <TextView android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/accent_cyan" android:textSize="10sp"
                    android:layout_marginStart="10dp"
                    android:visibility="gone"/>

                <TextView android:id="@+id/tvState"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:layout_marginStart="10dp" android:letterSpacing="0.04"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <ImageButton android:id="@+id/btnShare"
            android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/bg_icon_btn" android:src="@drawable/ic_share"
            android:padding="7dp"
            android:tint="@color/text_dim"
            android:contentDescription="Partager"/>

        <ImageButton android:id="@+id/btnRetry"
            android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_btn" android:src="@drawable/ic_refresh"
            android:padding="7dp"
            android:tint="@color/accent_cyan"
            android:contentDescription="Relancer" android:visibility="gone"/>

        <ImageButton android:id="@+id/btnDelete"
            android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_btn" android:src="@drawable/ic_trash"
            android:padding="7dp"
            android:tint="@color/text_dim"
            android:contentDescription="Supprimer"/>
    </LinearLayout>

    <!-- Progress bar (visible during download) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:progressTint="@color/accent_cyan"
        android:progressBackgroundTint="@color/border_cyan"
        android:max="100"
        android:visibility="gone"/>

</LinearLayout>
