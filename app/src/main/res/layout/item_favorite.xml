<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_item"
    android:clickable="true"
    android:focusable="true">

    <!-- Star icon -->
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_star"
        android:tint="@color/status_warning"
        android:layout_marginEnd="14dp"/>

    <!-- Info column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_bright"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"/>
    </LinearLayout>

    <!-- Open button -->
    <ImageButton
        android:id="@+id/btnOpen"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_icon_btn_cyan"
        android:src="@drawable/ic_arrow_right"
        android:padding="8dp"
        android:tint="@color/accent_cyan"
        android:contentDescription="Ouvrir"
        android:layout_marginStart="6dp"/>

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_icon_btn"
        android:src="@drawable/ic_trash"
        android:padding="8dp"
        android:tint="@color/text_dim"
        android:contentDescription="Supprimer"
        android:layout_marginStart="4dp"/>

</LinearLayout>
