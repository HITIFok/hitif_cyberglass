<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag handle — glowing bar -->
    <View android:layout_width="44dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="10dp"
        android:gravity="center_vertical" android:background="@drawable/bg_panel_header">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_holo_cube"
            android:tint="@color/accent_cyan"
            android:layout_marginEnd="12dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VIDEO DOWNLOAD" android:textColor="@color/accent_cyan"
                android:textSize="11sp" android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/tvMediaCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="En attente de médias…"
                android:textColor="@color/text_dim" android:textSize="11sp"/>
        </LinearLayout>

        <android.widget.Button android:id="@+id/btnSeason"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="📺 SAISONS" android:textColor="@color/accent_magenta"
            android:textSize="9sp" android:background="@drawable/bg_icon_btn"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:visibility="gone" android:layout_marginEnd="6dp"/>

        <ImageButton android:id="@+id/btnDownloadAll"
            android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/bg_icon_btn_cyan" android:src="@drawable/ic_download_all"
            android:padding="9dp"
            android:tint="@color/accent_cyan"
            android:contentDescription="Tout télécharger"/>

        <ImageButton android:id="@+id/btnClearAll"
            android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn" android:src="@drawable/ic_trash"
            android:padding="9dp"
            android:tint="@color/text_dim"
            android:contentDescription="Vider"/>

        <ImageButton android:id="@+id/btnClose"
            android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn" android:src="@drawable/ic_close"
            android:padding="10dp"
            android:tint="@color/text_dim"
            android:contentDescription="Fermer"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@drawable/bg_divider_cyan"/>

    <!-- Empty state -->
    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
        android:layout_height="240dp" android:orientation="vertical"
        android:gravity="center" android:visibility="visible">
        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_holo_cube_large"
            android:tint="@color/accent_cyan"
            android:alpha="0.5"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="EN ATTENTE DE MÉDIAS…"
            android:textColor="@color/accent_cyan" android:textSize="10sp"
            android:letterSpacing="0.28" android:alpha="0.7"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Naviguez sur une page contenant des vidéos"
            android:textColor="@color/text_dim" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>

    <!-- Media list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="16dp" android:visibility="gone"/>

</LinearLayout>
