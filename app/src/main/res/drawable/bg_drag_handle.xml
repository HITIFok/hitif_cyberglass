<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/border_cyan"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp"/>
            <gradient android:angle="0" android:startColor="#22F2A65A" android:centerColor="@color/border_cyan_glow" android:endColor="#22F2A65A"/>
        </shape>
    </item>
</layer-list>
