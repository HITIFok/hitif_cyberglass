<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp"/>
            <solid android:color="@color/border_cyan"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="29dp" android:topRightRadius="29dp"/>
            <gradient android:angle="270" android:startColor="#F0221611" android:endColor="#EA120B08"/>
            <stroke android:width="1dp" android:color="@color/border_cyan_hi"/>
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="70dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"/>
            <gradient android:angle="270" android:startColor="@color/glass_sheen_top" android:endColor="@color/glass_sheen_bot"/>
        </shape>
    </item>
</layer-list>
