<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top edge glow line -->
    <item android:bottom="0dp" android:top="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#3300F5FF"/>
        </shape>
    </item>
    <!-- Glass body -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#F0071424" android:endColor="#F0050F1C"/>
            <stroke android:width="0dp" android:color="#00000000"/>
        </shape>
    </item>
    <!-- Top inner sheen -->
    <item android:top="1dp" android:gravity="top" android:height="40dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#12FFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>
