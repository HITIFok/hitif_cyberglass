<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/border_cyan"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp"/>
            <gradient android:angle="270" android:startColor="#F0241711" android:endColor="#EA130C09"/>
            <stroke android:width="1dp" android:color="@color/border_cyan"/>
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp"/>
            <gradient android:angle="270" android:startColor="#14FFF6EE" android:endColor="#00FFF6EE"/>
        </shape>
    </item>
</layer-list>
