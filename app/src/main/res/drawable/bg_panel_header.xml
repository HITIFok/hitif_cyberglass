            <gradient android:angle="270" android:startColor="#F02B1B14" android:endColor="#E0160E0A"/>
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1.5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00F2A65A" android:centerColor="@color/border_cyan_hi" android:endColor="#00F2A65A"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#10FFF6EE" android:endColor="#00FFF6EE"/>
        </shape>
    </item>
</layer-list>
