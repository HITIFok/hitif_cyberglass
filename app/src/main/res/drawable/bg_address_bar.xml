<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="@color/border_cyan"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient android:angle="270" android:startColor="#D0281B15" android:endColor="#B318100C"/>
            <stroke android:width="1dp" android:color="@color/border_cyan_hi"/>
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="26dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"/>
            <gradient android:angle="270" android:startColor="@color/glass_sheen_top" android:endColor="@color/glass_sheen_bot"/>
        </shape>
    </item>
</layer-list>
