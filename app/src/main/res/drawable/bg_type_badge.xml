<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="@color/border_cyan"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <gradient android:angle="270" android:startColor="#B5332117" android:endColor="#9C211510"/>
            <stroke android:width="1dp" android:color="@color/border_cyan"/>
        </shape>
    </item>
</layer-list>
