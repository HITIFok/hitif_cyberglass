<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#3300F5FF"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#AA0E2840" android:endColor="#99091E32"/>
            <stroke android:width="1dp" android:color="#4400F5FF"/>
        </shape>
    </item>
</layer-list>
