<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <solid android:color="@color/border_cyan_hi"/>
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp"/>
                    <solid android:color="#7A3B261A"/>
                    <stroke android:width="1dp" android:color="@color/border_cyan_glow"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <solid android:color="@color/border_cyan"/>
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp"/>
                    <solid android:color="#5A241710"/>
                    <stroke android:width="1dp" android:color="@color/border_cyan_hi"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <solid android:color="#18F2A65A"/>
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp"/>
                    <solid android:color="#401A110D"/>
                    <stroke android:width="1dp" android:color="@color/border_cyan"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
