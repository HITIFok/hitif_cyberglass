<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#0000F5FF" android:centerColor="#2200F5FF"
                android:endColor="#0000F5FF"/>
        </shape>
    </item>
    <!-- Core line -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#0000F5FF" android:centerColor="#6600F5FF"
                android:endColor="#0000F5FF"/>
        </shape>
    </item>
</layer-list>
