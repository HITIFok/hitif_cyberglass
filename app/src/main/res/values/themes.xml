<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HITIFBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dim</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSecondary">@color/accent_magenta</item>
        <item name="colorOnSecondary">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorError">@color/status_error</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Glass.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Glass.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Glass.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.HITIF.Dialog</item>
    </style>

    <style name="ShapeAppearance.Glass.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Glass.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ShapeAppearance.Glass.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
    </style>

    <style name="Theme.BottomSheet.Holo" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="bottomSheetStyle">@style/Widget.BottomSheet.Holo</item>
    </style>

    <style name="Widget.BottomSheet.Holo" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BottomSheet.Holo</item>
    </style>

    <style name="ShapeAppearance.BottomSheet.Holo" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">30dp</item>
        <item name="cornerSizeTopRight">30dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Toolbar.IconButton" parent="">
        <item name="android:background">@drawable/bg_toolbar_btn</item>
        <item name="android:tint">@color/text_dim</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="ThemeOverlay.HITIF.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.HITIF.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.HITIF.DialogButton.Negative</item>
    </style>

    <style name="Widget.HITIF.DialogButton.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_cyan</item>
    </style>

    <style name="Widget.HITIF.DialogButton.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_dim</item>
    </style>

</resources>
